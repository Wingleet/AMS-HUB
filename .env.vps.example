# =============================================================================
# AMS Hub - Hostinger VPS Environment Variables (hub.wingleet.tech)
# =============================================================================
# Companion to docker-compose.vps.yml. Copy to `.env` on the VPS — that exact
# name, because Compose only auto-loads `.env` and a deploy triggered from the
# Hostinger Docker manager passes no --env-file.
#
# Names only, never values. Never commit the real .env.
#
# There is no DOMAIN here, unlike .env.prod.example: the central Caddy in
# /root/caddy terminates TLS for this host, so the app's own proxy has no
# certificate to obtain and no domain to know about.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL) — internal to the compose network, no published port
# -----------------------------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Backend (Symfony) — APP_ENV/APP_DEBUG are pinned in the compose file
# -----------------------------------------------------------------------------

# Generate with: openssl rand -hex 32
# Rotating APP_SECRET or JWT_SECRET invalidates every issued session.
APP_SECRET=
JWT_SECRET=

# DATABASE_URL is assembled from the POSTGRES_* values by the compose file.
# TRUSTED_PROXIES defaults to private_ranges in the compose file; override only
# to narrow it.

# Public URL, used by Symfony for link generation and by the SSO redirects.
DEFAULT_URI=

# Allowed CORS origins, as a regex.
CORS_ALLOW_ORIGIN=

# AMS REST API — the authority on credentials. Sign-in POSTs to /Login with the
# end user's own Basic auth plus the mandatory `version` / `serverdb` /
# `serverdbpass` headers, so AMS_API_USER and AMS_API_PASSWORD (the service
# account) are needed only by app:sync-ams, never to log in.
AMS_API_URL=
AMS_API_DB=
AMS_API_DB_PASSWORD=
AMS_API_VERSION=
AMS_API_USER=
AMS_API_PASSWORD=

# -----------------------------------------------------------------------------
# Hub accounts
# -----------------------------------------------------------------------------
# AMS knows nothing about who administers the hub, so these AMS usernames
# (comma-separated) receive ROLE_ADMIN when their hub account is created on
# first sign-in. Leave empty and nobody can reach /admin — no local password
# remains as a fallback.
HUB_ADMIN_USERNAMES=

# Organization attached to accounts created on first AMS sign-in.
HUB_DEFAULT_ORGANIZATION=

# -----------------------------------------------------------------------------
# Frontend (React/Vite)
# -----------------------------------------------------------------------------
# Baked into the bundle at build time, so a change here needs `up -d --build`,
# not a restart.
VITE_API_URL=
